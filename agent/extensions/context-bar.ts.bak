import type { ExtensionAPI } from "@mariozechner/pi-coding-agent";
import type { Component } from "@mariozechner/pi-tui";
import * as path from "node:path";

// ── ANSI 256-color helpers ──────────────────────────────────────────
const ansi = (code: number) => (s: string) => `\x1b[38;5;${code}m${s}\x1b[0m`;

const C = {
  orange:  ansi(208),
  cyan:    ansi(43),
  purple:  ansi(141),
  yellow:  ansi(220),
  red:     ansi(196),
  green:   ansi(42),
  grey:    ansi(243),
  faint:   ansi(240),
} as const;

const SEP = C.grey(" ▸ ");

// ── Helpers ──────────────────────────────────────────────────────────

/** Strip ANSI escapes to get visible character count. */
function visLen(s: string): number {
  return s.replace(/\x1b\[[0-9;]*m/g, "").length;
}

function fmtTokens(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `${Math.round(n / 1_000)}k`;
  return String(n);
}

/** Format model ID for display — strip provider prefix if present. */
function fmtModel(id: string): string {
  // Drop common prefixes like "deepseek/" or "openai/"
  return id.replace(/^[a-z-]+\//, "");
}

// ── State ────────────────────────────────────────────────────────────

interface State {
  model: string;       // model display name
  thinking: string;    // thinking level ("off" | "minimal" | "low" | "medium" | "high" | "xhigh")
  project: string;     // project name (cwd basename)
  branch: string | null; // git branch, null if not in repo
  ctxPercent: number | null;
  ctxWindow: number;
}

// ── Segment builders ─────────────────────────────────────────────────

function buildSegments(s: State): string[] {
  const segs: string[] = [];

  // 1. π brand — always present
  segs.push(C.orange("π"));

  // 2. Model
  if (s.model) segs.push(C.cyan(fmtModel(s.model)));

  // 3. Thinking level (skip when off or empty)
  if (s.thinking && s.thinking !== "off") {
    segs.push(C.purple(`think:${s.thinking}`));
  }

  // 4. Project (cwd)
  if (s.project) segs.push(C.cyan(s.project));

  // 5. Git branch
  if (s.branch && s.branch !== "detached") {
    segs.push(C.yellow(`⎇ ${s.branch}`));
  } else if (s.branch === "detached") {
    segs.push(C.yellow("⎇ HEAD"));
  }

  // 6. Context usage — always last
  if (s.ctxWindow > 0) {
    const pct = s.ctxPercent;
    if (pct === null) {
      // Unknown (e.g. right after compaction)
      segs.push(C.faint("⊞ ?") + C.grey(`/${fmtTokens(s.ctxWindow)}`));
    } else {
      let color = C.green;
      if (pct > 90) color = C.red;
      else if (pct > 70) color = C.yellow;
      segs.push(C.grey("⊞ ") + color(`${pct.toFixed(1)}%`) + C.grey(`/${fmtTokens(s.ctxWindow)}`));
    }
  }

  return segs;
}

/** Build the powerline line from segments, trimming from the right if needed. */
function renderLine(s: State, width: number): string {
  const allSegs = buildSegments(s);
  if (allSegs.length === 0) return "";

  // Try all segments, then drop rightmost until it fits (keep at least π + ctx)
  let segs = [...allSegs];
  let line = segs.join(SEP);

  while (visLen(line) > width - 2 && segs.length > 2) {
    segs = segs.slice(0, -1);
    line = segs.join(SEP);
  }

  // Absolute minimum: just π
  if (visLen(line) > width - 2 && segs.length > 1) {
    line = segs[0]; // π only
  }

  return visLen(line) <= width - 2 ? ` ${line}` : "";
}

// ── Extension entry point ────────────────────────────────────────────

export default function (pi: ExtensionAPI) {
  let active = true;
  let tuiRef: any = null;

  const state: State = {
    model: "",
    thinking: "",
    project: path.basename(process.cwd()),
    branch: null,
    ctxPercent: null,
    ctxWindow: 0,
  };

  /** Refresh context usage from ctx, trigger re-render. */
  function refreshContext(ctx: any) {
    if (!active) return;
    const usage = ctx.getContextUsage?.();
    if (usage) {
      state.ctxPercent = usage.percent ?? null;
      state.ctxWindow = usage.contextWindow ?? 0;
    }
    tuiRef?.requestRender();
  }

  // ── Event handlers ──────────────────────────────────────────────

  pi.on("session_start", async (_e, ctx) => {
    active = true;

    // Capture initial model + thinking state
    if (ctx.model) {
      state.model = ctx.model.name || ctx.model.id;
      state.thinking = "off"; // will be updated by thinking_level_select if needed
    }
    state.project = path.basename(process.cwd());

    // Set up the Powerline footer
    ctx.ui.setFooter((tui, _theme, footerData) => {
      tuiRef = tui;

      // Initial git branch
      state.branch = footerData.getGitBranch();

      // React to branch changes
      const dispose = footerData.onBranchChange(() => {
        state.branch = footerData.getGitBranch();
        tui.requestRender();
      });

      return {
        render: (width: number) => {
          if (width < 20) return [""];
          return [renderLine(state, width)];
        },
        invalidate: () => {},
        dispose,
      };
    });

    refreshContext(ctx);
  });

  pi.on("session_shutdown", () => {
    active = false;
    tuiRef = null;
  });

  pi.on("model_select", async (event, ctx) => {
    state.model = event.model.name || event.model.id;
    tuiRef?.requestRender();
    refreshContext(ctx);
  });

  pi.on("thinking_level_select", async (event, ctx) => {
    state.thinking = event.level;
    tuiRef?.requestRender();
  });

  pi.on("message_update", async (_e, ctx) => refreshContext(ctx));
  pi.on("after_provider_response", async (_e, ctx) => refreshContext(ctx));
  pi.on("agent_end", async (_e, ctx) => refreshContext(ctx));
}
